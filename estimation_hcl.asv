% Step 2: Define directory containing Excel files
clear all; close all; clc;
dir_path = 'C:\REPOS\PPBIO-Optical-Model\Data_HCL\data_excel';
% Step 3: Initialize struct to store data
data_dict = struct();

% Step 4: List and sort files
file_list = dir(fullfile(dir_path, '*.xlsx'));

% Step 5: Read files into struct
for i = 1:length(file_list)
    [~, base_name, ext] = fileparts(file_list(i).name);
    file_name = [base_name ext];  % Full filename with extension
    
    % Read Excel file
    file_path = fullfile(dir_path, file_name);
    data = readtable(file_path);
    
    % Clean field name (remove special characters)
    field_name = matlab.lang.makeValidName(file_name);
    
    % Store in struct
    data_dict.(field_name) = data;
end

%% Main Processing
max_values_dict = struct();
concentration = [0.06, 0.08];
window_size = 10;
time_array = {};
refrac_index_array = {};

% Assuming data_dict is a struct array with field names as file names
file_names = fieldnames(data_dict);
for i = 1:length(file_names)
    file_name = file_names{i};
    data = data_dict.(file_name);
    
    % Extract data
    time = data.Time / 1e3;
    refrac_var = data.("RefractiveIndex") / 1e3;
    
    % Store data
    time_array{end+1} = time;
    refrac_index_array{end+1} = refrac_var;
    
    % Find top values
    [sorted_refrac, sort_idx] = sort(refrac_var, 'descend');
    top_indices = sort_idx(1:window_size);
    
    % Calculate means
    mean_value = mean(refrac_var(top_indices));
    mean_time = mean(time(top_indices));
    
    % Store results
    max_values_dict.(file_name) = struct(...
        'mean_value', mean_value, ...
        'mean_time', mean_time, ...
        'concentration', concentration(i));
    
    % Plotting
    figure('Position', [100 100 642 100], 'Color', 'w');
    scatter(time, refrac_var, 10, 'filled');
    hold on;
    scatter(mean_time, mean_value, 50, 'r', 'filled');
    ylabel('Refractive Index');
    xlabel('Time (s)');
    legend(sprintf('Mean Value: %.4f\nMean Time: %.2fs', mean_value, mean_time), ...
        'Location', 'best', 'FontSize', 8);
    title(sprintf('Plot for %s', file_name));
end

%% Calculate Ka and Nmol
C1 = max_values_dict.HCL_0_06M_xlsx.concentration;
C2 = max_values_dict.HCL_0_08M_xlsx.concentration;
R1 = max_values_dict.HCL_0_06M_xlsx.mean_value;
R2 = max_values_dict.HCL_0_08M_xlsx.mean_value;

A = [R1, -C1; 
     R2, -C2];
B = [-C1*R1; 
     -C2*R2];
S = A \ B;
Ka = abs(1/S(1));
var_n_mol_thetainf = abs(S(2));

Constants_1 = table(R1, C1, R2, C2, Ka, var_n_mol_thetainf, ...
    'VariableNames', {'Ns1', 'C1', 'Ns2', 'C2', 'KA', 'Nmol'});
disp(Constants_1);

%% RLS Implementation
% Initialize parameters
n_experiments = length(concentration);
Concentration_anti = concentration;

% Prepare data
u_list = cell(n_experiments, 1);
dt_list = cell(n_experiments, 1);
for i = 1:n_experiments
    u = concentration(i) * ones(size(refrac_index_array{i}));
    u_list{i} = u;
    dt = diff(time_array{i});
    dt = [dt; dt(end)];
    dt_list{i} = dt;
end

% RLS parameters
P = eye(3) * 1e6;
lambda_ = 1;
gamma = -1;
beta = -gamma * var_n_mol_thetainf;
alpha = 1 + gamma / Ka;

theta_history_per_exp = cell(n_experiments, 1);
theta_experiments = cell(n_experiments, 1);

for exp_idx = 1:n_experiments
    u = u_list{exp_idx};
    y = refrac_index_array{exp_idx};
    n_points = length(y);
    theta = [alpha; beta; gamma];
    theta_history = zeros(n_points, 3);
    
    for k = 1:n_points-1
        phi = [y(k); u(k); u(k)*y(k)];
        y_obs = y(k+1);
        
        K = P * phi / (lambda_ + phi' * P * phi);
        theta = theta + K * (y_obs - phi' * theta);
        
        % Apply constraints
        theta(1) = min(theta(1), 1 - 1e-6);
        theta(2) = max(theta(2), 1e-6);
        theta(3) = min(theta(3), -1e-6);
        
        P = (P - K * phi' * P) / lambda_;
        theta_history(k,:) = theta';
    end
    theta_history(end,:) = theta';
    theta_history_per_exp{exp_idx} = theta_history;
    theta_experiments{exp_idx} = theta;
end

%% Parameter Analysis and Plotting
kd_final_list = [];
ka_final_list = [];
theta_inf_final_list = [];

for exp_idx = 1:n_experiments
    theta_history = theta_history_per_exp{exp_idx};
    dt = dt_list{exp_idx};
    
    alpha_hist = theta_history(:,1);
    beta_hist = theta_history(:,2);
    gamma_hist = theta_history(:,3);
    
    kd_hist = (1 - alpha_hist) ./ dt;
    ka_hist = -gamma_hist ./ dt;
    theta_inf_hist = beta_hist ./ (ka_hist .* dt);
    
    kd_final_list(exp_idx) = kd_hist(end);
    ka_final_list(exp_idx) = ka_hist(end);
    theta_inf_final_list(exp_idx) = theta_inf_hist(end);
    
    subplot(3, 1, 1);
    plot(ka_hist, color="b");
    xlabel("Iteration");ylabel("k_a$");

    subplot(3, 1, 2);
    plot(kd_hist, color="g");
    xlabel("Iteration");ylabel("k_d");

    subplot(3, 1, 3);
    plot(theta_inf_hist, color="m")
    xlabel("Iteration");ylabel("$\\theta_{inf}$")
end

%% State Estimation
y_hat_list = cell(n_experiments, 1);
for exp_idx = 1:n_experiments
    final_ka = ka_final_list(exp_idx);
    final_kd = kd_final_list(exp_idx);
    final_theta_inf = theta_inf_final_list(exp_idx);
    dt = dt_list{exp_idx};
    y = refrac_index_array{exp_idx};
    u = u_list{exp_idx};
    
    y_hat = zeros(size(y));
    y_hat(1) = y(1);
    
    for k = 2:length(y)
        y_hat(k) = y_hat(k-1) + dt(k-1) * (...
            final_ka * u(k-1) * (final_theta_inf - y_hat(k-1)) - ...
            final_kd * y_hat(k-1));
    end
    y_hat_list{exp_idx} = y_hat;
end

%% Final Plotting
figure('Color', 'w', 'Position', [100 100 800 500]);
colors = lines(n_experiments);
for exp_idx = 1:n_experiments
    y = refrac_index_array{exp_idx} * 1e3;
    y_hat = y_hat_list{exp_idx} * 1e3;
    K_a = ka_final_list(exp_idx) / kd_final_list(exp_idx);
    N_max = (y(end) * (concentration(exp_idx) + 1/K_a)) / ...
        (concentration(exp_idx) * theta_inf_final_list(exp_idx));
    
    plot(y, 'Color', colors(exp_idx,:), 'LineWidth', 2);
    hold on;
    plot(y_hat, '--', 'Color', colors(exp_idx,:), 'LineWidth', 1.5);
end

xlabel('Time Step');
ylabel('\Delta n_s^{eff} [mRIU]');
legend('Actual 0.06M', 'Estimated 0.06M', 'Actual 0.08M', 'Estimated 0.08M');
grid on;