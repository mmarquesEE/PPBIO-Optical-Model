function transport_limited_adsorption_3d
    % Main function for 3D flow-driven adsorption simulation
    clear all; close all; clc;

    % ==================== SIMULATION PARAMETERS ====================
    gridN_x = 8;                  % Length dimension (columns)
    gridN_y = 8;                  % Depth dimension (uniform slices)
    gridN_z = 8;                  % Height dimension (rows)
    roughness_scale = 1;         % Surface roughness intensity (0-1)
    c0 = 200e-9;                   % Inlet concentration (M)
    c0_diss = 0;                    % Dissociation phase concentration
    k_flow_horizontal = 100;        % Horizontal flow rate (columns/s)
    k_flow_vertical = 100;          % Vertical flow rate (rows/s)
    ru_to_m = 1e-6;
    t_association = 300;
    t_dissociation = 600;
    adsorption_z_layer = 1;        % z=0 surface layer (bottom row)
    inlet_x = 1; outlet_x = gridN_x;

    % ==================== PARAMETER GENERATION ====================
    [kon_grid, koff_grid, smax_grid] = generate_3d_parameters(...
        gridN_x, gridN_y, gridN_z, roughness_scale);

    % ==================== SIMULATION EXECUTION ====================
    [t, c_s, s] = simulate_3d_flow_model(gridN_x, gridN_y, gridN_z,...
        kon_grid, koff_grid, smax_grid, k_flow_horizontal, k_flow_vertical,...
        c0, c0_diss, t_association, t_dissociation, ru_to_m, adsorption_z_layer);

    % ==================== VISUALIZATION ====================
    create_main_figures(t, s, kon_grid, koff_grid, smax_grid, gridN_x, gridN_y);
    create_flow_animation(t, c_s, s, inlet_x, outlet_x, gridN_z);
end

%% Parameter Generation
function [kon_grid, koff_grid, smax_grid] = generate_3d_parameters(...
    nx, ny, nz, roughness_scale)
    % Create 3D parameter grids with adsorption only at z=0 (bottom layer)
    [X,Y] = meshgrid(linspace(-1,1,nx), linspace(-1,1,ny));
    Z = exp(-(X.^2 + Y.^2)/0.3);
    
    % Generate roughness pattern for surface (z=0)
    roughness = imfilter(randn(nx,ny), Z, 'circular');
    roughness = roughness/max(abs(roughness(:)));
    
    % Base parameters
    koff = 1e-3; 
    KD = 1e-9;
    
    % Initialize 3D grids
    kon_grid = zeros(nx, ny, nz);
    koff_grid = zeros(nx, ny, nz);
    smax_grid = zeros(nx, ny, nz);
    
    % Only populate bottom layer (z=0)
    kon_grid(:,:,1) = (koff/KD) * (1 + roughness_scale*roughness);
    koff_grid(:,:,1) = koff * (1 - 0.4*roughness_scale*roughness);
    smax_grid(:,:,1) = 100;  % RU/site
end

%% 3D Flow Simulation
function [t, c_s, s] = simulate_3d_flow_model(nx, ny, nz, kon_grid,...
    koff_grid, smax_grid, k_flow_h, k_flow_v, c0_assoc,c0_diss, t_assoc,...
    t_total, ru_to_m, ads_layer)
    
    % Initialize state variables (x,y,z)
    c_s = zeros(nx, ny, nz);
    s = zeros(nx, ny, nz);
    
    % Flatten for ODE solver (x,y,z concatenated)
    y0 = [c_s(:); s(:)];
    
     % Time parameters
    tspan_assoc = linspace(0, t_assoc, t_assoc/10);
    tspan_diss = linspace(t_assoc, t_total, t_assoc/10);
    
    % Solve ODE
    options = odeset('RelTol',1e-5,'AbsTol',1e-8);

    [t_assoc, y_assoc] = ode15s(@(t,y) ode_system(t,y,nx,ny,nz,k_flow_h,k_flow_v,...
        kon_grid,koff_grid,smax_grid,c0_assoc,ru_to_m,ads_layer), tspan_assoc, y0, options);
    [t_diss, y_diss] = ode15s(@(t,y) ode_system(t,y,nx,ny,nz,k_flow_h,k_flow_v,...
        kon_grid,koff_grid,smax_grid,c0_diss,ru_to_m,ads_layer), tspan_diss, y_assoc(end,:)', options);
    % Combine results
    t = [t_assoc; t_diss];
    y = [y_assoc; y_diss];
    % Reshape results
    c_s = reshape(y(:,1:nx*ny*nz), [length(t), nx, ny, nz]);
    s = reshape(y(:,nx*ny*nz+1:end)+ randn(length(t), 1)*0.1, [length(t), nx, ny, nz]);
end

%% ODE System for 3D Flow
function dydt = ode_system(t,y,nx,ny,nz,k_flow_h,k_flow_v,kon_grid,...
    koff_grid,smax_grid,c0,ru_to_m,ads_layer)
    
    % Reshape state variables
    c_s = reshape(y(1:nx*ny*nz), [nx, ny, nz]);
    s = reshape(y(nx*ny*nz+1:end), [nx, ny, nz]);
    
    dcsdt = zeros(nx, ny, nz);
    dsdt = zeros(nx, ny, nz);
    
    % ==================== FLOW TRANSPORT ====================
    % Horizontal flow (x-direction)
    for x = 2:nx
        dcsdt(x,:,:) = dcsdt(x,:,:) + k_flow_h*(c_s(x-1,:,:) - c_s(x,:,:));
    end
    
    % Vertical flow (z-direction)
    for z = 2:nz
        dcsdt(:,:,z) = dcsdt(:,:,z) + k_flow_v*(c_s(:,:,z-1) - c_s(:,:,z));
    end
    
    % Boundary conditions
    dcsdt(1,:,1) = dcsdt(1,:,1) + k_flow_h*(c0 - c_s(1,:,1)); % Inlet
    dcsdt(end,:,end) = dcsdt(end,:,end) - k_flow_v*c_s(end,:,end); % Outlet
    
    % ==================== ADSORPTION KINETICS ====================
    % Only at adsorption layer (z=0)
    ads_mask = zeros(nx,ny,nz);
    ads_mask(:,:,ads_layer) = 1;
    
    active_kon = kon_grid.*ads_mask;
    active_koff = koff_grid.*ads_mask;
    active_smax = smax_grid.*ads_mask;
    
    dsdt = active_kon.*c_s.*(active_smax - s) - active_koff.*s;
    dcsdt = dcsdt - dsdt*ru_to_m;
    
    % Flatten derivatives
    dydt = [dcsdt(:); dsdt(:)];
end

%% Visualization Functions for 3D System
function create_main_figures(t, s, kon_grid, koff_grid, smax_grid, gridN_x, gridN_y)
    % Creates analysis figures for 3D flow model
    figure('Name','3D System Analysis','Position',[100 100 1200 400])
    
    % ==================== Coverage Dynamics ====================
    subplot(1,4,1)
    hold on
    x_positions = round(linspace(1, gridN_x));
    center_size = round(gridN_y * 1);
    start_idx = floor((gridN_y - center_size)/2) + 1;
    end_idx = start_idx + center_size - 1;
    rows_to_plot = round(linspace(start_idx,end_idx));
    % Plot coverage at different x positions at mid-depth
    for x = x_positions
        plot(t, mean(s(:, rows_to_plot, x), 2), 'LineWidth', 2)
    end
    title('Coverage Dynamics by Column')
    xlabel('Time (s)'), ylabel('Coverage (RU)')
    
    % ==================== Parameter Correlations ====================
    subplot(1,4,2)
    % Extract surface parameters (z=0 layer)
    surface_kon = kon_grid(:,:,1);
    surface_koff = koff_grid(:,:,1);
    surface_smax = smax_grid(:,:,1);
    
    scatter3(surface_kon(:), surface_koff(:), surface_smax(:), 50, 'filled')
    title('Surface Parameter Correlations')
    xlabel('k_{on}'), ylabel('k_{off}'), zlabel('s_{max}')
    grid on
    
    % ==================== Total Coverage ====================
    subplot(1,4,3)
    % Sum over all x,y positions in surface layer (z=0)
    total_coverage = sum(s(:,:,:,1), [2 3]);  
    plot(t, total_coverage, 'LineWidth',2)
    title('Total Surface Coverage')
    xlabel('Time (s)'), ylabel('Total RU (z=0 plane)')

    % Final surface coverage (x-y plane at z=1)
    subplot(1,4,4)
    [X,Y] = meshgrid(1:gridN_x, 1:gridN_y);
    % Proper dimensions: [nx, ny] data with [ny, nx] grid requires transpose
    surf(X', Y', squeeze(s(end,:,:,1)))
    title('Final Surface Coverage (z=0 plane)')
    xlabel('Length (x)'), ylabel('Depth (y)'), zlabel('Coverage (RU)')
end

%% Enhanced 3D Visualization
function create_flow_animation(t, c_s, s, inlet_x, outlet_x, gridN_z)
    filename = '3D_flow_animation.gif';
    h = figure('Position', [100 100 1000 400], 'Color', 'w');
    
    max_conc = max(c_s(:));
    max_cov = max(s(:));
    
    for i = 1:length(t)
        % ===== Concentration Profile (x-z plane at mid-depth) =====
        subplot(1,2,1)
        mid_y = round(size(c_s,3)/2);
        conc_slice = squeeze(c_s(i,:,mid_y,:))';
        imagesc(conc_slice)
        hold on;
        plot(inlet_x, gridN_z, 'g.', 'MarkerSize', 20) % Bottom inlet
        plot(outlet_x, gridN_z, 'r.', 'MarkerSize', 20)      % Top outlet
        hold off;
        title(sprintf('Conc. @ y=%d, t=%.1fs', mid_y, t(i)))
        xlabel('Length (x)'), ylabel('Height (z)')
        axis equal tight
        colorbar
        caxis([0 max_conc])
        
        % ===== Surface Coverage (x-y plane at z=0) =====
        subplot(1,2,2)
        surface_cov = squeeze(s(i,:,:,1));
        imagesc(surface_cov)
        title('Surface Coverage (z=0 plane)')
        xlabel('Length (x)'), ylabel('Depth (y)')
        axis equal tight
        colorbar
        caxis([0 max_cov])
        
        % Capture frame
        frame = getframe(h);
        im = frame2im(frame);
        [imind, cm] = rgb2ind(im, 256);
        
        % Write to GIF
        if i == 1
            imwrite(imind, cm, filename, 'gif',...
                    'LoopCount', inf, 'DelayTime', 0.1);
        else
            imwrite(imind, cm, filename, 'gif',...
                    'WriteMode', 'append', 'DelayTime', 0.1);
        end
    end
end

function create_3d_flow_animation(t, c_s, s, gridN_x, gridN_y, gridN_z)
    filename = '3d_flow_animation.gif';
    h = figure('Position', [100 100 1200 500], 'Color', 'w');
    
    % Set up 3D visualization parameters
    [X,Y,Z] = meshgrid(1:gridN_x, 1:gridN_y, 1:gridN_z);
    max_conc = max(c_s(:));
    max_cov = max(s(:));
    
    % Create initial plots
    subplot(1,2,1)
    [~, hc] = contour3D_slices(c_s(1,:,:,:), X, Y, Z);
    h_title1 = title('3D Concentration Field');
    xlabel('Length (x)'), ylabel('Depth (y)'), zlabel('Height (z)')
    axis tight equal
    view(3)
    colorbar
    caxis([0 max_conc])
    
    subplot(1,2,2)
    h_surf = surf(squeeze(s(1,:,:,1)));
    h_title2 = title('Surface Coverage (z=0)');
    xlabel('Length (x)'), ylabel('Depth (y)')
    axis tight equal
    view(2)
    colorbar
    caxis([0 max_cov])
    
    % Animation parameters
    n_frames = min(50, length(t));  % Limit frames for performance
    frame_indices = round(linspace(1, length(t), n_frames));
    view_angles = linspace(0, 360, n_frames);
    
    for i = 1:n_frames
        idx = frame_indices(i);
        
        % Update concentration plot
        subplot(1,2,1)
        delete(hc)  % Clear previous slices
        [hc, h_title1] = update_3d_slices(c_s(idx,:,:,:), X, Y, Z, max_conc,...
            sprintf('Conc. Field @ t=%.1fs\nView Angle: %.0f°', t(idx), view_angles(i)));
        view(view_angles(i), 30)
        
        % Update surface coverage plot
        subplot(1,2,2)
        set(h_surf, 'ZData', squeeze(s(idx,:,:,1)));
        h_title2.String = sprintf('Surface Coverage @ t=%.1fs', t(idx));
        drawnow
        
        % Capture frame
        frame = getframe(h);
        im = frame2im(frame);
        [imind, cm] = rgb2ind(im, 256);
        
        % Write to GIF
        if i == 1
            imwrite(imind, cm, filename, 'gif',...
                    'LoopCount', inf, 'DelayTime', 0.1);
        else
            imwrite(imind, cm, filename, 'gif',...
                    'WriteMode', 'append', 'DelayTime', 0.1);
        end
    end
end

%% Helper function for 3D slice visualization
function [hc, h_title] = update_3d_slices(data, X, Y, Z, max_val, title_str)
    % Create orthogonal slices through 3D data
    slice_pos = [
        round(size(X,2)/2), [], [];  % x-slice
        [], round(size(Y,1)/2), [];  % y-slice
        [], [], round(size(Z,3)/2)   % z-slice
    ];
    
    hc = slice(X, Y, Z, permute(data, [2 1 3]),...
              slice_pos(:,1), slice_pos(:,2), slice_pos(:,3));
    set(hc, 'EdgeColor','none', 'FaceAlpha',0.8)
    colormap(jet)
    caxis([0 max_val])
    h_title = title(title_str);
end